# サーバー証明書の作り方。keytoolへ渡す値をここで決めます。
# クライアントは https://localhost:<port> へ接続します。

# 証明書の主体。CN=（Common Name）はいまは参考情報で、接続先の判断には使われません
dname=CN=cafe-api

# 接続先として有効な名前。dns: と ip: をコンマで並べます
# 接続先が localhost なので、SANへ localhost を入れる（CNでは代用できない）
san=dns:localhost,ip:127.0.0.1

# 有効期間（日）。短く作り、入れ替えを前提にします
validity=30
