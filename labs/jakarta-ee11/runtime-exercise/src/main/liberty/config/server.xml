<?xml version="1.0" encoding="UTF-8"?>
<!--
  この演習ではserver.xmlを編集しません。Feature Managerの扱いは
  業務フレームワーク編『Open Liberty実践入門』で行います。
  ここで使うのはJakarta EE 11のうち4つのFeatureだけです。
-->
<server description="Jakarta EE 11 runtime exercise">
  <featureManager>
    <feature>restfulWS-4.0</feature>
    <feature>cdi-4.1</feature>
    <feature>jsonb-3.0</feature>
    <feature>validation-3.1</feature>
  </featureManager>
  <httpEndpoint id="defaultHttpEndpoint" host="127.0.0.1"
                httpPort="${env.JQ_LAB_PORT}" httpsPort="-1"/>
  <webApplication location="users.war" contextRoot="/"/>
</server>
