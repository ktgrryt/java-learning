<?xml version="1.0" encoding="UTF-8"?>
<!--
  JPAの設定。参照専用（この演習では編集しません）。

  接続先は採点側が動的ポートで作るので、URLとユーザーは実行時に渡します。
  発行されたSQLの本数を数えるため、統計を有効にしてあります。
-->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">
  <persistence-unit name="cafe" transaction-type="RESOURCE_LOCAL">
    <class>cafe.jpa.Customer</class>
    <class>cafe.jpa.CustomerOrder</class>
    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
      <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
      <property name="hibernate.generate_statistics" value="true"/>
      <property name="hibernate.show_sql" value="false"/>
    </properties>
  </persistence-unit>
</persistence>
