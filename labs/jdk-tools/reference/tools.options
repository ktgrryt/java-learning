# 目的ごとに、使うJDK付属ツールとオプションを書きます。
# 名前を覚えるためではなく、その道具でしか出ない出力を実際に得るためです。

# 目的1: 本番のJVMはJava 21。そこで動くclass fileを作る版
compile.release=21

# 目的2: 出来たclass fileが「どの版のJVM向けか」と、文字列連結がどの命令になったかを読む
bytecode.tool=javap
bytecode.flag=-verbose

# 目的3: 実行に必要なJDK moduleだけを一覧する
modules.tool=jdeps
modules.flag=--print-module-deps
