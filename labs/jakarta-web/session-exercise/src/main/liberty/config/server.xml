<?xml version="1.0" encoding="UTF-8"?>
<!--
  この演習ではserver.xmlを編集しません。使うのはServletのFeature 1つだけです。
  ポートは採点側が確保した空きポートを環境変数から受け取ります（固定しません）。
-->
<server description="session exercise">
  <featureManager>
    <feature>servlet-6.1</feature>
  </featureManager>
  <httpEndpoint id="defaultHttpEndpoint" host="127.0.0.1"
                httpPort="${env.JQ_LAB_PORT}" httpsPort="-1"/>
  <webApplication location="cart.war" contextRoot="/"/>
</server>
