<?xml version="1.0" encoding="UTF-8"?>
<!--
  この演習ではserver.xmlを編集しません。
  Jakarta REST・CDI・JSON-B・Bean ValidationのFeatureを有効にしてあります。
  ポートは採点側が確保した空きポートを環境変数から受け取ります（固定しません）。
-->
<server description="validation exercise">
  <featureManager>
    <feature>restfulWS-4.0</feature>
    <feature>cdi-4.1</feature>
    <feature>jsonb-3.0</feature>
    <feature>validation-3.1</feature>
  </featureManager>
  <httpEndpoint id="defaultHttpEndpoint" host="127.0.0.1"
                httpPort="${env.JQ_LAB_PORT}" httpsPort="-1"/>
  <webApplication location="orders-api.war" contextRoot="/"/>
</server>
