<?xml version="1.0" encoding="UTF-8"?>
<!--
  この演習ではserver.xmlを編集しません。
  利用者の登録先（誰がどの役割か）はJavaのIdentityStoreで与えてあります。
  ポートは採点側が確保した空きポートを環境変数から受け取ります（固定しません）。
-->
<server description="security exercise">
  <featureManager>
    <feature>restfulWS-4.0</feature>
    <feature>cdi-4.1</feature>
    <feature>jsonb-3.0</feature>
    <feature>appSecurity-6.0</feature>
  </featureManager>
  <httpEndpoint id="defaultHttpEndpoint" host="127.0.0.1"
                httpPort="${env.JQ_LAB_PORT}" httpsPort="-1"/>
  <webApplication location="secure-api.war" contextRoot="/"/>
</server>
