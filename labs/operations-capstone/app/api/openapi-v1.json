{
  "openapi": "3.1.0",
  "info": {
    "title": "Orders API",
    "version": "1.0.0"
  },
  "paths": {
    "/orders": {
      "get": {
        "summary": "顧客の注文一覧を新しい注文から順に返す",
        "responses": {
          "200": {
            "description": "注文一覧",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/OrderSummary" }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OrderSummary": {
        "type": "object",
        "required": ["orderId", "storeName", "amount"],
        "properties": {
          "orderId": { "type": "integer", "format": "int64" },
          "storeName": { "type": "string" },
          "amount": { "type": "integer" }
        }
      }
    }
  }
}
