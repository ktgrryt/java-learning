<?xml version="1.0" encoding="UTF-8"?>
<!--
  この pom.xml には、実際によくある問題が入っています。
  「動いているように見えるビルド」を、再現できて配布できるビルドへ直してください。
  ビルドは成功します。成功しているのに何が足りないのかを、Mavenの出力から読み取ってください。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>cafe.learning</groupId>
  <artifactId>testing-maven-lab</artifactId>
  <version>1.0.0-SNAPSHOT</version>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.13.4</junit.version>
    <!-- TODO 「あとで直す」つもりで残ったまま、テストが一度も走らなくなっている -->
    <skipTests>true</skipTests>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <!-- TODO どの場面のクラスパスで必要かを宣言していないので、実行時の依存にも混ざる -->
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.6</version>
        <configuration>
          <useModulePath>false</useModulePath>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <!-- TODO 版を書いていないので、同じ手順でも将来ちがう版で固められる -->
        <configuration>
          <!-- TODO targetごと詰めているので、配布物にテストのクラスまで入る -->
          <classesDirectory>${project.build.directory}</classesDirectory>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
